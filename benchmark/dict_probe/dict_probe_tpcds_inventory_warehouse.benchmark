# name: benchmark/dict_probe/dict_probe_tpcds_inventory_warehouse.benchmark
# description: Dictionary-probing optimisation: TPC-DS inventory (~133M, SF10) joined to warehouse (~15 rows) on inv_warehouse_sk pre-cast to VARCHAR (DuckDB does not dict-compress integer columns). N/D ~= 8.9M -- largest probe side and smallest dimension across both benchmark suites, maximising the cross-batch dictionary cache short-circuit (D -> 0 lookups on warm chunks).
# group: [dict_probe]

name dict_probe_tpcds_inventory_warehouse
group dict_probe

require tpcds

storage persistent

cache tpcds_sf10.duckdb

load
SET threads = 1;
CALL dsdgen(sf=10);
CREATE OR REPLACE TABLE inventory_v AS
SELECT inv_date_sk,
       inv_item_sk,
       CAST(inv_warehouse_sk AS VARCHAR) AS inv_warehouse_id,
       inv_quantity_on_hand
FROM   inventory;
CREATE OR REPLACE TABLE warehouse_v AS
SELECT CAST(w_warehouse_sk AS VARCHAR) AS w_warehouse_id,
       w_warehouse_name,
       w_state
FROM   warehouse;

run
SELECT w_warehouse_name,
       SUM(inv_quantity_on_hand) AS total_qty
FROM   inventory_v iv
JOIN   warehouse_v wv
       ON iv.inv_warehouse_id = wv.w_warehouse_id
GROUP  BY w_warehouse_name
ORDER  BY w_warehouse_name;
