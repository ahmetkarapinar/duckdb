# name: benchmark/dict_probe/dict_probe_tpch_customer_nation.benchmark
# description: Dictionary-probing optimisation: customer (1.5M, SF10) joined to nation (25 rows) on c_nationkey pre-cast and materialised as VARCHAR so storage dict-encodes it (DuckDB does not dict-compress integer columns). N/D = 60K. Mirrors the worked example in p3_2.md and serves as a regression baseline for the wrapped ht_probe scalar function.
# group: [dict_probe]

name dict_probe_tpch_customer_nation
group dict_probe

load
ATTACH '/Users/ahmetkarapinar/Desktop/tpch_sf10.db' AS tpch_sf10;
USE tpch_sf10;
SET threads = 1;
CREATE OR REPLACE TEMP TABLE customer_v AS
SELECT c_custkey,
       c_name,
       c_acctbal,
       CAST(c_nationkey AS VARCHAR) AS c_nation_id,
       c_mktsegment
FROM   tpch_sf10.customer;
CREATE OR REPLACE TEMP TABLE nation_v AS
SELECT CAST(n_nationkey AS VARCHAR) AS n_nation_id,
       n_name
FROM   tpch_sf10.nation;

run
SELECT n_name,
       COUNT(*)        AS cust_count,
       AVG(c_acctbal)  AS avg_balance
FROM   customer_v c
JOIN   nation_v   n
       ON c.c_nation_id = n.n_nation_id
GROUP  BY n_name
ORDER  BY n_name;
