# name: benchmark/dict_probe/dict_probe_neg_tpcds_large_d.benchmark
# description: Negative control for the dictionary-probing optimisation. Joins TPC-DS store_sales (~28.8M, SF10) to customer (~500K rows at SF10) on ss_customer_sk pre-cast to VARCHAR. D > MAX_DICTIONARY_SIZE_THRESHOLD (20000) -- even though the probe key is dict-eligible by storage encoding, TryExecuteDictionaryExpression's threshold guard at execute_function.cpp:60-83 disables the optimisation. Expected outcome: the wrapped ht_probe path falls back to per-row dispatch, giving at most a wash and never a regression vs. baseline.
# group: [dict_probe]

name dict_probe_neg_tpcds_large_d
group dict_probe

require tpcds

storage persistent

cache tpcds_sf10.duckdb

load
SET threads = 1;
CALL dsdgen(sf=10);
CREATE OR REPLACE TABLE store_sales_large_v AS
SELECT ss_sold_date_sk,
       ss_item_sk,
       CAST(ss_customer_sk AS VARCHAR) AS ss_customer_id,
       ss_ext_sales_price
FROM   store_sales
WHERE  ss_customer_sk IS NOT NULL;
CREATE OR REPLACE TABLE customer_large_v AS
SELECT CAST(c_customer_sk AS VARCHAR) AS c_customer_id,
       c_first_name,
       c_last_name
FROM   customer;

run
SELECT ss.ss_sold_date_sk, ss.ss_item_sk, ss.ss_ext_sales_price,
       c.c_first_name, c.c_last_name
FROM   store_sales_large_v ss
JOIN   customer_large_v   c
       ON ss.ss_customer_id = c.c_customer_id;
