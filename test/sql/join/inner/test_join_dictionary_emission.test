# name: test/sql/join/inner/test_join_dictionary_emission.test
# description: Test dictionary emission for small build side hash joins (NEXT_PTR embedding)
# group: [inner]

statement ok
PRAGMA enable_verification

statement ok
PRAGMA verify_parallelism

statement ok
CREATE TABLE customers (customer_id VARCHAR, name VARCHAR, city VARCHAR, tier VARCHAR);

statement ok
INSERT INTO customers VALUES
    ('C010', 'Alice', 'Berlin', 'Gold'),
    ('C010', 'Alice-EU', 'Vienna', 'Silver'),
    ('C020', 'Bob', 'Paris', 'Bronze'),
    ('C030', 'Charlie', 'London', 'Gold'),
    ('C040', 'Diana', 'Berlin', 'Silver'),
    ('C050', 'Eve', 'Tokyo', 'Bronze');

statement ok
CREATE TABLE orders (order_id INTEGER, customer_id VARCHAR, amount INTEGER);

statement ok
INSERT INTO orders VALUES
    (1001, 'C030', 500),
    (1002, 'C010', 200),
    (1003, 'C999', 900),
    (1004, 'C040', 350);

# inner join with VARCHAR key, duplicate build key, and an unmatched probe row
query IIIII
SELECT o.order_id, o.amount, c.name, c.city, c.tier
FROM orders o JOIN customers c ON o.customer_id = c.customer_id
ORDER BY o.order_id, c.name;
----
1001	500	Charlie	London	Gold
1002	200	Alice	Berlin	Gold
1002	200	Alice-EU	Vienna	Silver
1004	350	Diana	Berlin	Silver

# left join: unmatched probe rows emit NULL build columns
query IIIII
SELECT o.order_id, o.amount, c.name, c.city, c.tier
FROM orders o LEFT JOIN customers c ON o.customer_id = c.customer_id
ORDER BY o.order_id, c.name;
----
1001	500	Charlie	London	Gold
1002	200	Alice	Berlin	Gold
1002	200	Alice-EU	Vienna	Silver
1003	900	NULL	NULL	NULL
1004	350	Diana	Berlin	Silver

# right join: unmatched build rows emit NULL probe columns
query IIIII
SELECT o.order_id, o.amount, c.name, c.city, c.tier
FROM orders o RIGHT JOIN customers c ON o.customer_id = c.customer_id
ORDER BY c.name, o.order_id;
----
1002	200	Alice	Berlin	Gold
1002	200	Alice-EU	Vienna	Silver
NULL	NULL	Bob	Paris	Bronze
1001	500	Charlie	London	Gold
1004	350	Diana	Berlin	Silver
NULL	NULL	Eve	Tokyo	Bronze

# full outer join: both unmatched sides
query IIIII
SELECT o.order_id, o.amount, c.name, c.city, c.tier
FROM orders o FULL OUTER JOIN customers c ON o.customer_id = c.customer_id
ORDER BY c.name NULLS LAST, o.order_id;
----
1002	200	Alice	Berlin	Gold
1002	200	Alice-EU	Vienna	Silver
NULL	NULL	Bob	Paris	Bronze
1001	500	Charlie	London	Gold
1004	350	Diana	Berlin	Silver
NULL	NULL	Eve	Tokyo	Bronze
1003	900	NULL	NULL	NULL

# semi join with duplicate build keys: each probe row appears at most once
query II
SELECT o.order_id, o.customer_id
FROM orders o SEMI JOIN customers c ON o.customer_id = c.customer_id
ORDER BY o.order_id;
----
1001	C030
1002	C010
1004	C040

# anti join with duplicate build keys
query II
SELECT o.order_id, o.customer_id
FROM orders o ANTI JOIN customers c ON o.customer_id = c.customer_id
ORDER BY o.order_id;
----
1003	C999

# multi-column join condition (composite key)
statement ok
CREATE TABLE composite_build (a VARCHAR, b INTEGER, payload VARCHAR);

statement ok
INSERT INTO composite_build VALUES ('x', 1, 'p1'), ('y', 2, 'p2'), ('z', 3, 'p3');

statement ok
CREATE TABLE composite_probe (a VARCHAR, b INTEGER, val INTEGER);

statement ok
INSERT INTO composite_probe VALUES ('x', 1, 100), ('x', 2, 110), ('y', 2, 200), ('w', 9, 999);

query IIII
SELECT p.a, p.b, p.val, b.payload
FROM composite_probe p JOIN composite_build b ON p.a = b.a AND p.b = b.b
ORDER BY p.val;
----
x	1	100	p1
y	2	200	p2

# multiple payload columns of different physical types (VARCHAR, INTEGER, DECIMAL, DATE)
statement ok
CREATE TABLE products (sku VARCHAR, name VARCHAR, qty INTEGER, price DECIMAL(10,2), launch_date DATE);

statement ok
INSERT INTO products VALUES
    ('S1', 'Widget', 10, 9.99, DATE '2020-01-15'),
    ('S2', 'Gadget', 5, 19.50, DATE '2021-06-30'),
    ('S3', 'Sprocket', 100, 0.49, DATE '2019-12-31');

statement ok
CREATE TABLE sales (sale_id INTEGER, sku VARCHAR);

statement ok
INSERT INTO sales VALUES (1, 'S1'), (2, 'S2'), (3, 'S3'), (4, 'S1'), (5, 'S99');

query IIIIII
SELECT s.sale_id, p.name, p.qty, p.price, p.launch_date, s.sku
FROM sales s JOIN products p ON s.sku = p.sku
ORDER BY s.sale_id;
----
1	Widget	10	9.99	2020-01-15	S1
2	Gadget	5	19.50	2021-06-30	S2
3	Sprocket	100	0.49	2019-12-31	S3
4	Widget	10	9.99	2020-01-15	S1

# NULL keys on the build side: NULL keys do not match anything in the probe
statement ok
CREATE TABLE null_key_build (k VARCHAR, v VARCHAR);

statement ok
INSERT INTO null_key_build VALUES ('A', 'a-val'), (NULL, 'null-val'), ('B', 'b-val');

statement ok
CREATE TABLE null_key_probe (id INTEGER, k VARCHAR);

statement ok
INSERT INTO null_key_probe VALUES (1, 'A'), (2, NULL), (3, 'B');

query III
SELECT p.id, p.k, b.v
FROM null_key_probe p JOIN null_key_build b ON p.k = b.k
ORDER BY p.id;
----
1	A	a-val
3	B	b-val

# NULL values in the build payload propagate through the dictionary
statement ok
CREATE TABLE null_payload_build (k INTEGER, name VARCHAR, score INTEGER);

statement ok
INSERT INTO null_payload_build VALUES (1, 'one', NULL), (2, NULL, 200), (3, 'three', 300);

statement ok
CREATE TABLE null_payload_probe (id INTEGER, k INTEGER);

statement ok
INSERT INTO null_payload_probe VALUES (10, 1), (20, 2), (30, 3), (40, 4);

query IIII
SELECT p.id, p.k, b.name, b.score
FROM null_payload_probe p JOIN null_payload_build b ON p.k = b.k
ORDER BY p.id;
----
10	1	one	NULL
20	2	NULL	200
30	3	three	300

# empty build side (activation guard kicks in)
statement ok
CREATE TABLE empty_build (k VARCHAR, v VARCHAR);

query II
SELECT o.order_id, e.v
FROM orders o JOIN empty_build e ON o.customer_id = e.k;
----

# single-row build side
statement ok
CREATE TABLE single_build (k VARCHAR, v VARCHAR);

statement ok
INSERT INTO single_build VALUES ('C030', 'only');

query III
SELECT o.order_id, o.amount, s.v
FROM orders o JOIN single_build s ON o.customer_id = s.k
ORDER BY o.order_id;
----
1001	500	only

# long duplicate-key chain: stresses aux_next_ptrs and chain following via GetNextPointer
statement ok
CREATE TABLE long_chain_build (k VARCHAR, v INTEGER);

statement ok
INSERT INTO long_chain_build SELECT 'A', i FROM range(50) t(i);

statement ok
INSERT INTO long_chain_build VALUES ('B', 999);

statement ok
CREATE TABLE long_chain_probe (id INTEGER, k VARCHAR);

statement ok
INSERT INTO long_chain_probe VALUES (1, 'A'), (2, 'B'), (3, 'C');

query I
SELECT COUNT(*) FROM long_chain_probe p JOIN long_chain_build b ON p.k = b.k;
----
51

query III
SELECT p.id, p.k, COUNT(*)
FROM long_chain_probe p JOIN long_chain_build b ON p.k = b.k
GROUP BY p.id, p.k
ORDER BY p.id;
----
1	A	50
2	B	1

# the same long chain through SEMI / ANTI joins
query II
SELECT p.id, p.k
FROM long_chain_probe p SEMI JOIN long_chain_build b ON p.k = b.k
ORDER BY p.id;
----
1	A
2	B

query II
SELECT p.id, p.k
FROM long_chain_probe p ANTI JOIN long_chain_build b ON p.k = b.k
ORDER BY p.id;
----
3	C

# integer key with duplicates: still goes through the regular hash join (PHJ rejects duplicates)
statement ok
CREATE TABLE int_build (k INTEGER, v VARCHAR);

statement ok
INSERT INTO int_build VALUES (1, 'one-a'), (1, 'one-b'), (2, 'two');

statement ok
CREATE TABLE int_probe (id INTEGER, k INTEGER);

statement ok
INSERT INTO int_probe VALUES (100, 1), (200, 2), (300, 3);

query III
SELECT p.id, p.k, b.v
FROM int_probe p JOIN int_build b ON p.k = b.k
ORDER BY p.id, b.v;
----
100	1	one-a
100	1	one-b
200	2	two

# small probe side (below DICT_EMISSION_MIN_PROBE_ROWS): falls back to GatherResult
statement ok
CREATE TABLE fallback_build (k INTEGER, v VARCHAR);

statement ok
INSERT INTO fallback_build VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
CREATE TABLE fallback_probe AS SELECT i AS id, (i % 3) + 1 AS k FROM range(100) t(i);

query II
SELECT b.v, COUNT(*)
FROM fallback_probe p JOIN fallback_build b ON p.k = b.k
GROUP BY b.v
ORDER BY b.v;
----
a	34
b	33
c	33

# large probe side above DICT_EMISSION_MIN_PROBE_ROWS: dict emission activates
statement ok
CREATE TABLE nations (nation_key INTEGER, name VARCHAR);

statement ok
INSERT INTO nations VALUES (1, 'USA'), (2, 'Germany'), (3, 'Japan');

statement ok
CREATE TABLE big_orders AS
SELECT i AS order_id, (i % 3) + 1 AS nation_key
FROM range(300000) t(i);

query II
SELECT n.name, COUNT(*)
FROM big_orders b JOIN nations n ON b.nation_key = n.nation_key
GROUP BY n.name
ORDER BY n.name;
----
Germany	100000
Japan	100000
USA	100000

# no RHS output columns: dict emission is skipped via the !rhs_output_columns.empty() guard
query I
SELECT o.order_id
FROM orders o JOIN customers c ON o.customer_id = c.customer_id
ORDER BY o.order_id;
----
1001
1002
1002
1004

# STRUCT bailout: a STRUCT-typed RHS output column disables dict emission inside
# PrepareDictionaryArrays. The query must still produce correct results via GatherResult.
statement ok
CREATE TABLE struct_build (k VARCHAR, payload STRUCT(x INTEGER, y VARCHAR));

statement ok
INSERT INTO struct_build VALUES
    ('A', {'x': 1, 'y': 'one'}),
    ('B', {'x': 2, 'y': 'two'}),
    ('C', {'x': 3, 'y': 'three'});

statement ok
CREATE TABLE struct_probe (id INTEGER, k VARCHAR);

statement ok
INSERT INTO struct_probe VALUES (1, 'A'), (2, 'B'), (3, 'D');

query II
SELECT p.id, b.payload
FROM struct_probe p JOIN struct_build b ON p.k = b.k
ORDER BY p.id;
----
1	{'x': 1, 'y': one}
2	{'x': 2, 'y': two}
