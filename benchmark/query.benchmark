# name: benchmark/query.benchmark
# description: Custom hash join benchmark on TPC-H SF100
# group: [custom]

name custom_hash_join
group custom

load
ATTACH '/Users/ahmetkarapinar/Desktop/tpch_sf100.db' AS tpch_sf100;
USE tpch_sf100;
SET threads = 1;

run
SELECT n.n_name, COUNT(*) as cnt FROM nation n JOIN customer c ON hash(n.n_nationkey) = hash(c.c_nationkey) GROUP BY n.n_name;
