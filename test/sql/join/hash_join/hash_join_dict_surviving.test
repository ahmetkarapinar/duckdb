# name: test/sql/join/hash_join/hash_join_dict_surviving.test
# description: Test the dict-surviving (compressed-materialized) hash join: a build-side payload
# description: column that arrives as a pipeline-global DICTIONARY_VECTOR (from a Perfect Hash Join
# description: or from Project 1's small-build dict emission) is stored as a narrow dictionary index
# description: in the row store and re-emitted as a DICTIONARY_VECTOR at probe time.
# group: [hash_join]

# verify_parallelism forces multi-threaded execution even on small inputs, so the build side splits
# across thread-local hash tables that each pin a dictionary and reconcile through JoinHashTable::Merge.
statement ok
PRAGMA threads=4

statement ok
PRAGMA verify_parallelism

# join_order is disabled so the written join order is preserved and the pipeline-global dictionary
# reliably lands on the build side of the downstream join, where dict-surviving activates.
statement ok
SET disabled_optimizers='join_order'

# ----------------------------------------------------------------------------------------------------
# Shared dataset for the Perfect-Hash-Join producer chain.
# ----------------------------------------------------------------------------------------------------

# nation: 25 rows, dense integer key 0..24 -> the first join uses a Perfect Hash Join, which mints
# pipeline-global DICTIONARY_VECTORs for the VARCHAR n_name and the INTEGER n_region (dict size 25).
statement ok
CREATE TABLE nation AS
SELECT i AS nk, 'NATION_' || (i % 5) AS n_name, ((i % 5) * 10)::INTEGER AS n_region
FROM range(25) t(i)

# customer: c_custkey range 0..1,999,000 exceeds the Perfect Hash Join build-range limit, so the
# SECOND join falls through to the regular hash-join path where dict-surviving can activate.
statement ok
CREATE TABLE customer AS SELECT i * 1000 AS ck, i % 25 AS nk FROM range(2000) t(i)

# orders: 8000 probe rows; (nation JOIN customer) is the smaller side and becomes the build.
statement ok
CREATE TABLE orders AS SELECT i AS ok, (i % 2000) * 1000 AS ck FROM range(8000) t(i)

# ----------------------------------------------------------------------------------------------------
# 1. Basic PHJ -> dict-surviving activation on a VARCHAR column (1-byte index, D=25).
# ----------------------------------------------------------------------------------------------------
query II
SELECT n.n_name, COUNT(*) AS cnt
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY n.n_name ORDER BY n.n_name
----
NATION_0	1600
NATION_1	1600
NATION_2	1600
NATION_3	1600
NATION_4	1600

# 1b. Variable-width index over an INTEGER payload: native 4 bytes, D=25 -> narrows to a 1-byte index.
query II
SELECT n.n_region, COUNT(*) AS cnt
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY n.n_region ORDER BY n.n_region
----
0	1600
10	1600
20	1600
30	1600
40	1600

# 1c. Multiple narrowed payload columns survive together (VARCHAR + INTEGER).
query III
SELECT n.n_name, n.n_region, COUNT(*) AS cnt
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY n.n_name, n.n_region ORDER BY n.n_name
----
NATION_0	0	1600
NATION_1	10	1600
NATION_2	20	1600
NATION_3	30	1600
NATION_4	40	1600

# ----------------------------------------------------------------------------------------------------
# 2. Variable-width index: a 2-byte index when the dictionary needs more than 256 slots.
# nation2 has a dense key range 0..299, so the Perfect Hash Join dictionary child has 300 slots.
# ----------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE nation2 AS SELECT i AS nk, 'NAME_' || i AS n_name FROM range(300) t(i)

statement ok
CREATE TABLE customer2 AS SELECT i * 1000 AS ck, i % 300 AS nk FROM range(2000) t(i)

statement ok
CREATE TABLE orders2 AS SELECT i AS ok, (i % 2000) * 1000 AS ck FROM range(8000) t(i)

query II
SELECT COUNT(*), COUNT(DISTINCT u.n_name)
FROM (
    SELECT n.n_name FROM nation2 n JOIN customer2 c ON n.nk = c.nk JOIN orders2 o ON o.ck = c.ck
) u
----
8000	300

# ----------------------------------------------------------------------------------------------------
# 3. Chained dict-surviving: PHJ -> dict-surviving -> dict-surviving across two downstream joins.
# join_order is left enabled here so each smaller dict-carrying result becomes the next build side.
# ----------------------------------------------------------------------------------------------------
statement ok
SET disabled_optimizers=''

statement ok
CREATE TABLE lineitem AS SELECT i AS lk, (i % 8000) * 1000 AS ok FROM range(30000) t(i)

statement ok
CREATE TABLE orders_c AS SELECT i * 1000 AS ok, (i % 2000) * 1000 AS ck FROM range(8000) t(i)

query II
SELECT n.n_name, COUNT(*) AS cnt
FROM nation n
JOIN customer c ON n.nk = c.nk
JOIN orders_c o ON o.ck = c.ck
JOIN lineitem l ON l.ok = o.ok
GROUP BY n.n_name ORDER BY n.n_name
----
NATION_0	6000
NATION_1	6000
NATION_2	6000
NATION_3	6000
NATION_4	6000

statement ok
SET disabled_optimizers='join_order'

# ----------------------------------------------------------------------------------------------------
# 4. CachingPhysicalOperator: a tiny build (<= the cache threshold) forces the pipeline-global dict
# chunks through the caching operator, which must coalesce them without flattening (otherwise the
# downstream sink keys row indices into the wrong dictionary).
# ----------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE customer_tiny AS SELECT i * 100000 AS ck, i % 25 AS nk FROM range(50) t(i)

statement ok
CREATE TABLE orders_tiny AS SELECT i AS ok, (i % 50) * 100000 AS ck FROM range(200) t(i)

query II
SELECT n.n_name, COUNT(*) AS cnt
FROM nation n JOIN customer_tiny c ON n.nk = c.nk JOIN orders_tiny o ON o.ck = c.ck
GROUP BY n.n_name ORDER BY n.n_name
----
NATION_0	40
NATION_1	40
NATION_2	40
NATION_3	40
NATION_4	40

# ----------------------------------------------------------------------------------------------------
# 5. Join types that route through GatherRHS (dict-surviving eligible): INNER (above), SEMI, ANTI.
# ----------------------------------------------------------------------------------------------------

# SEMI: the small dict-carrying side is flipped to a RIGHT_SEMI build side and emits through GatherRHS.
query I
SELECT COUNT(*)
FROM (SELECT c.ck, n.n_name FROM nation n JOIN customer c ON n.nk = c.nk) u
SEMI JOIN orders o ON u.ck = o.ck
----
2000

# ANTI: every dict-carrying build row matches an order, so none survive.
query I
SELECT COUNT(*)
FROM (SELECT c.ck, n.n_name FROM nation n JOIN customer c ON n.nk = c.nk) u
ANTI JOIN orders o ON u.ck = o.ck
----
0

# ----------------------------------------------------------------------------------------------------
# 6. LEFT JOIN (excluded from dict-surviving): NextUniqueLeftJoin gathers RHS columns outside
# GatherRHS, so a narrowed slot would be misread. The optimization is gated off; results stay correct
# including the NULL-filled unmatched-probe rows.
# build_side_probe_side is also disabled so the dict-carrying side stays a genuine LEFT-join build side.
# ----------------------------------------------------------------------------------------------------
statement ok
SET disabled_optimizers='join_order,build_side_probe_side'

statement ok
CREATE TABLE orders_miss AS
SELECT i AS ok, CASE WHEN i < 800 THEN 999999999 ELSE (i % 2000) * 1000 END AS ck FROM range(8000) t(i)

query II
SELECT COALESCE(u.n_name, 'NO_MATCH') AS nm, COUNT(*) AS cnt
FROM orders_miss o
LEFT JOIN (SELECT c.ck, n.n_name FROM nation n JOIN customer c ON n.nk = c.nk) u ON o.ck = u.ck
GROUP BY nm ORDER BY nm
----
NATION_0	1440
NATION_1	1440
NATION_2	1440
NATION_3	1440
NATION_4	1440
NO_MATCH	800

# ----------------------------------------------------------------------------------------------------
# 7. FULL OUTER JOIN (excluded from dict-surviving): its constant-NULL left-fill chunks make the
# output stream non-uniform, so a downstream consumer must not see a falsely pipeline-global dict.
# The gate excludes OUTER; results stay correct with unmatched rows on both sides.
# ----------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE customer_orphan AS
SELECT i * 1000 AS ck, i % 25 AS nk FROM range(2000) t(i)
UNION ALL SELECT 7777777, 0

query II
SELECT COALESCE(u.n_name, 'NO_MATCH') AS nm, COUNT(*) AS cnt
FROM orders_miss o
FULL OUTER JOIN (SELECT c.ck, n.n_name FROM nation n JOIN customer_orphan c ON n.nk = c.nk) u ON o.ck = u.ck
GROUP BY nm ORDER BY nm
----
NATION_0	1441
NATION_1	1440
NATION_2	1440
NATION_3	1440
NATION_4	1440
NO_MATCH	800

statement ok
SET disabled_optimizers='join_order'

# ----------------------------------------------------------------------------------------------------
# 8. NULL handling.
# ----------------------------------------------------------------------------------------------------

# 8a. NULL keys on the probe side: under equality NULL never matches, so those rows are dropped.
statement ok
CREATE TABLE orders_null_probe AS
SELECT i AS ok, CASE WHEN i < 100 THEN NULL ELSE (i % 2000) * 1000 END AS ck FROM range(8000) t(i)

query II
SELECT n.n_name, COUNT(*) AS cnt
FROM nation n JOIN customer c ON n.nk = c.nk JOIN orders_null_probe o ON o.ck = c.ck
GROUP BY n.n_name ORDER BY n.n_name
----
NATION_0	1580
NATION_1	1580
NATION_2	1580
NATION_3	1580
NATION_4	1580

# 8b. NULL keys on the build side: build rows with a NULL join key are carried in the dict-surviving
# build stream but match no probe row under equality.
statement ok
CREATE TABLE customer_null_key AS
SELECT CASE WHEN i < 100 THEN NULL ELSE i * 1000 END AS ck, i % 25 AS nk FROM range(2000) t(i)

query II
SELECT n.n_name, COUNT(*) AS cnt
FROM nation n JOIN customer_null_key c ON n.nk = c.nk JOIN orders o ON o.ck = c.ck
GROUP BY n.n_name ORDER BY n.n_name
----
NATION_0	1520
NATION_1	1520
NATION_2	1520
NATION_3	1520
NATION_4	1520

# 8c. NULL values in the dictionary payload plus dictionary NULL slots: nation_gap leaves gaps in the
# integer key range (so the Perfect Hash Join dictionary child has NULL slots) and a NULL n_name. The
# self-owned dictionary child must preserve those NULLs 1:1.
statement ok
CREATE TABLE nation_gap (nk INTEGER, n_name VARCHAR)

statement ok
INSERT INTO nation_gap VALUES (0, 'A'), (1, 'B'), (2, 'A'), (5, 'C'), (6, NULL)

statement ok
CREATE TABLE customer_gap AS
SELECT i * 1000 AS ck, (CASE WHEN i % 7 IN (3, 4) THEN 9 ELSE i % 7 END) AS nk FROM range(2000) t(i)

statement ok
CREATE TABLE orders_gap AS SELECT i AS ok, (i % 2000) * 1000 AS ck FROM range(8000) t(i)

query II
SELECT n.n_name, COUNT(*) AS cnt
FROM nation_gap n JOIN customer_gap c ON n.nk = c.nk JOIN orders_gap o ON o.ck = c.ck
GROUP BY n.n_name ORDER BY n.n_name NULLS FIRST
----
NULL	1140
A	2288
B	1144
C	1140

# ----------------------------------------------------------------------------------------------------
# 9. UNION ALL on the build side: a build pipeline fed by UNION ALL has multiple source operators, so
# the publisher's "decide once on the first chunk" contract is unsound. The whole join is disqualified
# rather than narrow a slot a later branch could arrive flat under.
# ----------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE other_flat AS SELECT i * 1000 + 500 AS ck, 'FLAT_' || (i % 5) AS n_name FROM range(2000) t(i)

statement ok
CREATE TABLE probe_mixed AS SELECT i * 500 AS pk FROM range(8000) t(i)

query II
SELECT u.n_name, COUNT(*) AS cnt
FROM probe_mixed p JOIN (
    SELECT c.ck AS ck, n.n_name FROM nation n JOIN customer c ON n.nk = c.nk
    UNION ALL
    SELECT o.ck, o.n_name FROM other_flat o
) u ON p.pk = u.ck
GROUP BY u.n_name ORDER BY u.n_name
----
FLAT_0	400
FLAT_1	400
FLAT_2	400
FLAT_3	400
FLAT_4	400
NATION_0	400
NATION_1	400
NATION_2	400
NATION_3	400
NATION_4	400

# ----------------------------------------------------------------------------------------------------
# 10. Fallback: a storage dictionary is NOT pipeline-global (it rotates per row group), so the
# publisher must not admit it. Result is correct on the regular (non-narrowed) path.
# ----------------------------------------------------------------------------------------------------
statement ok
ATTACH '{TEST_DIR}/hash_join_dict_surviving.db' AS sdb

statement ok
PRAGMA force_compression='dictionary'

statement ok
CREATE TABLE sdb.dim (k VARCHAR PRIMARY KEY, name VARCHAR)

statement ok
INSERT INTO sdb.dim VALUES ('A', 'Alpha'), ('B', 'Beta'), ('C', 'Gamma'), ('D', 'Delta')

statement ok
CREATE TABLE sdb.fact (id INTEGER, k VARCHAR)

statement ok
INSERT INTO sdb.fact SELECT i, CASE i % 4 WHEN 0 THEN 'A' WHEN 1 THEN 'B' WHEN 2 THEN 'C' ELSE 'D' END FROM range(5000) t(i)

statement ok
CHECKPOINT sdb

query II
SELECT d.name, COUNT(*) AS cnt FROM sdb.fact f JOIN sdb.dim d ON f.k = d.k GROUP BY d.name ORDER BY d.name
----
Alpha	1250
Beta	1250
Delta	1250
Gamma	1250

statement ok
PRAGMA force_compression='auto'

# ----------------------------------------------------------------------------------------------------
# 11. Fallback: no pipeline-global producer (a large flat build with a small probe activates neither
# the Perfect Hash Join nor Project 1's dict emission), so dict-surviving never activates.
# ----------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE big_dim AS SELECT 'KEY_' || i AS k, 'LBL_' || (i % 5) AS lbl FROM range(50000) t(i)

statement ok
CREATE TABLE small_probe AS SELECT 'KEY_' || (i % 50000) AS k FROM range(1000) t(i)

query II
SELECT b.lbl, COUNT(*) AS cnt FROM small_probe p JOIN big_dim b ON p.k = b.k GROUP BY b.lbl ORDER BY b.lbl
----
LBL_0	200
LBL_1	200
LBL_2	200
LBL_3	200
LBL_4	200

# ----------------------------------------------------------------------------------------------------
# 12. Project 1 -> dict-surviving: a VARCHAR-keyed first join (no Perfect Hash Join) with a small
# build and a >262,144-row probe activates Project 1's dict emission, producing a pipeline-global
# DICTIONARY_VECTOR that the second join's sink narrows.
# ----------------------------------------------------------------------------------------------------
statement ok
CREATE TABLE dim AS SELECT 'KEY_' || i AS d_key, 'LABEL_' || (i % 5) AS d_label FROM range(100) t(i)

statement ok
CREATE TABLE fact1 AS SELECT 'KEY_' || (i % 100) AS f1_dkey, 'CUST_' || i AS f1_ckey FROM range(262200) t(i)

# fact2 has twice as many rows as the (dim JOIN fact1) result, so the dict-carrying result becomes the
# build side of the second join and each f1_ckey matches exactly twice.
statement ok
CREATE TABLE fact2 AS SELECT 'CUST_' || (i % 262200) AS f2_ckey FROM range(524400) t(i)

query II
SELECT d.d_label, COUNT(*) AS cnt
FROM dim d JOIN fact1 f1 ON d.d_key = f1.f1_dkey JOIN fact2 f2 ON f1.f1_ckey = f2.f2_ckey
GROUP BY d.d_label ORDER BY d.d_label
----
LABEL_0	104880
LABEL_1	104880
LABEL_2	104880
LABEL_3	104880
LABEL_4	104880
