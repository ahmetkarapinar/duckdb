# name: test/sql/join/hash_join/hash_join_dict_surviving_union_all.test
# description: UNION ALL build pipeline (multiple producers) must disqualify the dict-surviving join
# group: [hash_join]

# One branch emits a pipeline-global dictionary, the other arrives flat (or as a different dict).
# The dict-surviving optimisation must be disqualified for such multi-source builds (B-gate); the
# query must still execute and produce correct results.

statement ok
SET disabled_optimizers = 'join_order';

statement ok
CREATE TABLE nation AS SELECT i AS nk, 'NAME_LONG_PADDING_' || (i % 5) AS n_name FROM range(25) t(i);

statement ok
CREATE TABLE customer AS SELECT i * 100 AS ck, i % 25 AS nk FROM range(20000) t(i);

# flat branch: same column arrives as a flat VARCHAR, keys never collide with the dict branch (1 mod 100)
statement ok
CREATE TABLE other AS SELECT i * 100 + 1 AS ck, 'FLAT_PADDING_' || (i % 7) AS n_name FROM range(20000) t(i);

statement ok
CREATE TABLE probe AS SELECT (i % 40000) * 100 AS pk FROM range(100000) t(i);

# dict branch (nation JOIN customer, a perfect hash join) UNION ALL flat branch, used as the build side.
# Only the dict-branch keys (multiples of 100) match the probe; the result must be unaffected by the gate.
query II
SELECT count(*), count(u.n_name)
FROM probe p
JOIN (
    SELECT cc.ck AS ck, n.n_name FROM nation n JOIN customer cc ON n.nk = cc.nk
    UNION ALL
    SELECT o.ck AS ck, o.n_name FROM other o
) u ON p.pk = u.ck;
----
60000	60000

# the matched names come from the dict branch only; verify the grouped breakdown is correct
query II
SELECT u.n_name, count(*)
FROM probe p
JOIN (
    SELECT cc.ck AS ck, n.n_name FROM nation n JOIN customer cc ON n.nk = cc.nk
    UNION ALL
    SELECT o.ck AS ck, o.n_name FROM other o
) u ON p.pk = u.ck
GROUP BY u.n_name
ORDER BY u.n_name;
----
NAME_LONG_PADDING_0	12000
NAME_LONG_PADDING_1	12000
NAME_LONG_PADDING_2	12000
NAME_LONG_PADDING_3	12000
NAME_LONG_PADDING_4	12000

# both branches emit a pipeline-global dictionary, but with different child arrays / ids (identity variant).
# the gate must also disqualify this shape so the row codes never index into the wrong child.
query II
SELECT count(*), count(u.n_name)
FROM probe p
JOIN (
    SELECT cc.ck AS ck, n.n_name FROM nation n JOIN customer cc ON n.nk = cc.nk
    UNION ALL
    SELECT cc.ck + 1 AS ck, m.m_name FROM (SELECT i AS mk, 'OTHER_LONG_PADDING_' || (i % 3) AS m_name FROM range(25) t(i)) m
         JOIN customer cc ON m.mk = cc.nk
) u ON p.pk = u.ck;
----
60000	60000
