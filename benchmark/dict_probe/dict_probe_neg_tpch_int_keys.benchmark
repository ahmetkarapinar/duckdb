# name: benchmark/dict_probe/dict_probe_neg_tpch_int_keys.benchmark
# description: Negative control for the dictionary-probing optimisation. Runs the same customer x nation join shape as dict_probe_tpch_customer_nation but with c_nationkey kept as INT (no cast, no VARCHAR materialisation). Because DuckDB does not dict-compress integer columns, the probe key arrives at the join as a flat (non-dictionary) vector and TryExecuteDictionaryExpression bails at the gate. Expected outcome: no speedup vs. the pre-Project-3 path; this benchmark must NOT regress relative to baseline.
# group: [dict_probe]

name dict_probe_neg_tpch_int_keys
group dict_probe

load
ATTACH '/Users/ahmetkarapinar/Desktop/tpch_sf10.db' AS tpch_sf10;
USE tpch_sf10;
SET threads = 1;

run
SELECT c.c_custkey, c.c_name, c.c_acctbal, n.n_name
FROM   tpch_sf10.customer c
JOIN   tpch_sf10.nation   n
       ON c.c_nationkey = n.n_nationkey;
