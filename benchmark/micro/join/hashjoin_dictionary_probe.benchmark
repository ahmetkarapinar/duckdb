# name: benchmark/micro/join/hashjoin_dictionary_probe.benchmark
# description: Hash join probe over a dictionary-encoded VARCHAR key. Small build (D=10 dim rows) joined against a 1,000,000-row probe table; the probe-side key arrives as a storage-dictionary vector so TryProbeDictionary activates per chunk.
# group: [join]

name Hash Join Dictionary Probe
group join
storage persistent

load
CREATE TABLE dim AS SELECT format('key_{:03d}', i) AS k FROM range(10) t(i);
CREATE TABLE fact AS SELECT format('key_{:03d}', i % 10) AS k FROM range(1000000) t(i);

run
SELECT COUNT(*) FROM fact f JOIN dim d ON f.k = d.k

result I
1000000
