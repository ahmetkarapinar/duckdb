# name: benchmark/dict_probe/dict_probe_tpcds_store_sales_promotion.benchmark
# description: Dictionary-probing optimisation: TPC-DS store_sales (~28.8M, SF10) joined to promotion (~1000 rows) on ss_promo_sk pre-cast to VARCHAR. Moderate-D test (D ~= 1000): still under the 20K MAX_DICTIONARY_SIZE_THRESHOLD and below STANDARD_VECTOR_SIZE, so dict slicing fires in a single chunk. N/D ~= 28.8K. Useful for measuring the optimisation's behaviour at higher D where per-batch payoff per row is smaller.
# group: [dict_probe]

name dict_probe_tpcds_store_sales_promotion
group dict_probe

require tpcds

storage persistent

cache tpcds_sf10.duckdb

load
SET threads = 1;
CALL dsdgen(sf=10);
CREATE OR REPLACE TABLE store_sales_v AS
SELECT ss_sold_date_sk,
       ss_item_sk,
       CAST(ss_promo_sk AS VARCHAR) AS ss_promo_id,
       ss_ext_sales_price
FROM   store_sales
WHERE  ss_promo_sk IS NOT NULL;
CREATE OR REPLACE TABLE promotion_v AS
SELECT CAST(p_promo_sk AS VARCHAR) AS p_promo_id,
       p_channel_email,
       p_channel_tv
FROM   promotion;

run
SELECT p_channel_tv,
       SUM(ss_ext_sales_price) AS rev
FROM   store_sales_v ss
JOIN   promotion_v   p
       ON ss.ss_promo_id = p.p_promo_id
GROUP  BY p_channel_tv
ORDER  BY p_channel_tv;
